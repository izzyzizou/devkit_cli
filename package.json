    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "bin"
  ],
  "dependencies": {
    "zx": "^8.1.4",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
