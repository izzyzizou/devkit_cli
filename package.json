{
  "name": "devkit-cli",
  "version": "1.0.0",
  "description": "A composable command-line toolkit for automating repetitive development workflows.",
  "type": "module",
  "author": {
    "name": "Izzat A"
  },
  "bin": {
    "devkit": "./bin/devkit"
  },
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
